# LLM provider: auto / deepseek / claude
LLM_PROVIDER=auto

# Required when using DeepSeek directly.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=deepseek-v4-flash
DEEPSEEK_MODEL_STRONG=deepseek-v4-flash

# Optional Claude fallback.
ANTHROPIC_API_KEY=
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
CLAUDE_SONNET_MODEL=claude-sonnet-4-6

LLM_SCORING_BATCH_SIZE=40
